# Copy this file to .env and fill in whichever providers you've enabled in config/agents.yaml
# You only need keys for the providers actually referenced in your config.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
# For a local Ollama server, no key is required; OLLAMA_API_KEY can be left blank.
OLLAMA_API_KEY=not-needed
